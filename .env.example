# Copy to .env.local, then fill in the values printed by `npx supabase status`.
#
#   Project URL  ->  NEXT_PUBLIC_SUPABASE_URL
#   Secret       ->  SUPABASE_SECRET_KEY
#
# The secret key is the service-role equivalent: it bypasses Row Level Security.
# It is read only in server-side code and must never carry a NEXT_PUBLIC_ prefix,
# which would inline it into the browser bundle.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=sb_secret_replace_with_your_own
